# Variables the api process reads. Names only: real values never go in the
# repository. Copy to .env (git-ignored) for a local run.

# host:port the HTTP server binds. Defaults to :8080.
LISTEN_ADDR=

# Required. Absolute path of the data volume: state.db, cache.db and
# pre-migration/ live here.
DATA_DIR=

# Required. The Movie Database API key. Instead of the value, TMDB_API_KEY_FILE
# may name a mounted secret file that holds it; set one of the two, not both.
TMDB_API_KEY=

# Accounts. Exactly two, ACCOUNT_1_* and ACCOUNT_2_*, all required; each
# ACCOUNT_ variable also accepts a NAME_FILE variant naming a mounted secret.
# ACCOUNT_n_KEY ties the account to its database row and must never change
# once the app holds data; the other fields may change with a restart.
# Usernames are [a-z0-9._-] and may not hold "@"; usernames and emails are
# compared lower-cased and trimmed, and the two accounts may share neither.
# ACCOUNT_n_PASSWORD_HASH is an argon2id PHC string, at least m=19456,t=2,p=1,
# for example the output of:
#   printf %s 'the password' | argon2 "$(openssl rand -base64 16)" -id -t 2 -k 19456 -p 1 -e
ACCOUNT_1_KEY=
ACCOUNT_1_USERNAME=
ACCOUNT_1_EMAIL=
ACCOUNT_1_DISPLAY_NAME=
ACCOUNT_1_PASSWORD_HASH=
ACCOUNT_2_KEY=
ACCOUNT_2_USERNAME=
ACCOUNT_2_EMAIL=
ACCOUNT_2_DISPLAY_NAME=
ACCOUNT_2_PASSWORD_HASH=

# Required. Comma-separated scheme://host[:port] origins the app is served
# from: every request but GET and HEAD must carry a matching Origin or Referer.
ALLOWED_ORIGINS=

# Comma-separated CIDRs of the proxy in front of the api. Forwarded and
# X-Forwarded-* headers are read only from a peer inside one of them; empty
# trusts no proxy, and every client is then the TCP peer itself.
TRUSTED_PROXY_CIDRS=
