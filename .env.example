# Variables the api process reads. Names only: real values never go in the
# repository. Copy to .env (git-ignored) for a local run.

# host:port the HTTP server binds. Defaults to :8080.
LISTEN_ADDR=

# Required. Absolute path of the data volume: state.db, cache.db and
# pre-migration/ live here.
DATA_DIR=

# Required. The Movie Database API key. Instead of the value, TMDB_API_KEY_FILE
# may name a mounted secret file that holds it; set one of the two, not both.
TMDB_API_KEY=
