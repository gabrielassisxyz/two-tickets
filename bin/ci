#!/usr/bin/env bash
# The deterministic gate. CI runs exactly this script, so green here means green in CI.
# Sections switch on as the code they check lands: the Go checks once go.mod exists,
# the page-inventory check once web/package.json exists, and the web toolchain checks
# once web/src/compat exists. A section that cannot run yet is skipped,
# never faked green.
set -euo pipefail
cd "$(dirname "$0")/.."

# Keep Go's and Node's caches off /tmp, which is a tmpfs on the development machine.
# A CI runner has no /mnt/build and keeps the toolchain defaults.
build_root=/mnt/build
if [ -d "$build_root" ] && [ -w "$build_root" ]; then
    export GOCACHE="$build_root/go-build"
    export GOTMPDIR="$build_root/go-tmp"
    export NODE_COMPILE_CACHE="$build_root/node-compile-cache"
    mkdir -p "$GOTMPDIR"
fi

echo "==> gitleaks"
gitleaks git --no-banner --redact .

if [ -f go.mod ]; then
    echo "==> gofmt"
    unformatted=$(gofmt -l .)
    if [ -n "$unformatted" ]; then
        printf '%s\n' "$unformatted"
        echo "unformatted Go files; run: gofmt -w ." >&2
        exit 1
    fi
    echo "==> go vet"
    go vet ./...
    echo "==> golangci-lint"
    golangci-lint run
    echo "==> go test"
    go test ./...
    echo "==> govulncheck"
    govulncheck ./...
else
    echo "==> go: skipped (no go.mod yet)"
fi

if [ -f web/package.json ]; then
    echo "==> web page inventory"
    node --test web/tools/page-inventory/inventory.test.mjs
fi

if [ -d web/src/compat ]; then
    echo "==> web"
    pin="$(cat web/.node-version)"
    runner=""
    if command -v mise >/dev/null 2>&1; then
        runner="mise exec node@${pin} --"
    fi
    # The Node that will run is the runner's, not whatever is first on PATH.
    # shellcheck disable=SC2086
    major="$($runner node --version | sed 's/^v//; s/\..*//')"
    if [ "$major" != "$pin" ]; then
        echo "wrong Node major ${major}; web pins ${pin} in web/.node-version" >&2
        exit 1
    fi
    (
        cd web
        # shellcheck disable=SC2086
        $runner corepack pnpm install --frozen-lockfile
        # shellcheck disable=SC2086
        $runner corepack pnpm run format:check
        # shellcheck disable=SC2086
        $runner corepack pnpm run typecheck
        # shellcheck disable=SC2086
        $runner corepack pnpm run lint
        # shellcheck disable=SC2086
        $runner corepack pnpm run test
        # shellcheck disable=SC2086
        $runner corepack pnpm run build
        # shellcheck disable=SC2086
        $runner corepack pnpm audit --audit-level high
    )
    echo "==> web smoke"
    bash deploy/web-smoke.sh
    echo "==> web e2e"
    bash deploy/web-e2e.sh
else
    # Step 5 creates web/src/compat; the pristine tree cannot build without it.
    echo "==> web: skipped (no web/src/compat yet)"
fi

# The goldens harness has its own package and lockfile, apart from web/, and
# regenerates every golden from testdata/tmdb/ with no TMDB call. --check fails
# when a committed golden, derived fixture or the fixture index differs from
# what the pinned upstream code produces, and when the pinned commit cannot be
# fetched.
if [ -f web/tools/goldens/package.json ]; then
    echo "==> goldens"
    (
        cd web/tools/goldens
        # The harness pins Node like web/ does (engines plus engine-strict). A
        # CI runner gets that Node from setup-node; a machine with mise asks it.
        node_22=()
        if command -v mise >/dev/null 2>&1; then
            node_22=(mise exec node@22 --)
        fi
        if [ -d "$build_root" ] && [ -w "$build_root" ]; then
            export TMPDIR="$build_root/goldens-tmp"
            mkdir -p "$TMPDIR"
        fi
        export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
        "${node_22[@]}" corepack pnpm install --frozen-lockfile
        "${node_22[@]}" node --test lib/golden.test.mjs
        "${node_22[@]}" node generate.mjs --check
    )
fi

echo "bin/ci: green"
